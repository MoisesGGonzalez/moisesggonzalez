<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <style>
    html, body {
      margin: 0;
      padding: 0;
      overflow-x: scroll;
      overflow-y: hidden;
      width: 100%;
      height: 100vh;
      white-space: nowrap;
    }
    .section {
      display: inline-block;
      position: relative;
      width: 100vw;
      height: 100vh;
      background-size: cover;
      background-position: center;
      transition: transform 5s ease;
    }
    .section:hover {
      transform: scale(1.02);
    }
    .content {
      position: absolute;
      top: 50%;
      left: 10%;
      transform: translateY(-50%);
      color: white;
    }
    .title {
      font-size: 4em;
      margin: 0;
    }
    .subtitle {
      font-size: 2em;
      margin: 0;
    }
  </style>
</head>
<body>
  <div class="section" style="background-image: url('your-image.jpg');">
    <div class="content">
      <h1 class="title">Your Title</h1>
      <h2 class="subtitle">Your Name - Your Slogan</h2>
    </div>
  </div>
</body>
</html>
